<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ultimate 4K/8K Abstract Art Generator</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca' }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for control panel */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.4); }

        /* Custom range slider styling */
        input[type=range] {
            -webkit-appearance: none;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            height: 6px;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 16px;
            width: 16px;
            border-radius: 50%;
            background: #818cf8;
            cursor: pointer;
            transition: transform 0.1s ease;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
            background: #a5b4fc;
        }

        /* Glassmorphism panel styling */
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        /* Accordion transition */
        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s cubic-bezier(0, 1, 0, 1);
        }
        .accordion-content.active {
            max-height: 2000px;
            transition: max-height 0.5s ease-in-out;
        }

        .canvas-container {
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        }
    </style>
</head>
<body class="h-full w-full overflow-hidden text-slate-200 antialiased select-none font-sans bg-slate-950 flex">

    <!-- CANVAS VIEWPORT -->
    <main id="viewport" class="relative flex-1 h-full w-full flex items-center justify-center p-4 sm:p-8 bg-slate-950/80 overflow-hidden">
        
        <!-- Background Grid Pattern for Viewport -->
        <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>

        <!-- Render Target Container -->
        <div class="relative canvas-container max-w-full max-h-full flex items-center justify-center rounded-xl overflow-hidden border border-white/10 bg-black">
            <canvas id="artCanvas" class="max-w-full max-h-full object-contain block"></canvas>
        </div>

        <!-- Floating Quick Action Bar (Top Right) -->
        <div class="absolute top-4 right-4 flex items-center gap-3 z-30">
            <button id="btnToggleUI" title="Toggle UI Controls (Hotkey: H)" class="glass-panel hover:bg-white/20 text-white p-3 rounded-xl transition flex items-center gap-2 text-xs font-semibold shadow-xl border border-white/15">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <span id="lblToggleUI" class="hidden sm:inline">Hide Panel</span>
            </button>
            <button id="btnRandomizeAll" title="Randomize Everything" class="glass-panel hover:bg-indigo-600/50 bg-indigo-600/30 text-indigo-200 p-3 rounded-xl transition flex items-center gap-2 text-xs font-semibold shadow-xl border border-indigo-400/30">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                <span class="hidden sm:inline">Randomize All</span>
            </button>
            <button id="btnExport" title="Export High-Res PNG" class="bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white px-4 py-3 rounded-xl transition flex items-center gap-2 text-xs font-bold shadow-xl border border-indigo-300/30">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                <span>Export <span id="btnExportResLabel" class="text-indigo-200 font-normal">4K</span></span>
            </button>
        </div>

        <!-- Render Time / Resolution Status -->
        <div id="statusBadge" class="absolute bottom-4 right-4 glass-panel px-3 py-1.5 rounded-lg text-[11px] font-mono text-slate-400 z-20 flex items-center gap-2 border border-white/10">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="statusText">3840x2160 • 0ms</span>
        </div>
    </main>

    <!-- CONTROL SIDEBAR -->
    <aside id="sidebar" class="w-full sm:w-[420px] h-full glass-panel border-r border-white/10 flex flex-col z-40 transition-all duration-300 relative shrink-0">
        
        <!-- Sidebar Header -->
        <div class="p-5 border-b border-white/10 flex items-center justify-between bg-slate-900/40">
            <div class="flex items-center gap-3">
                <div class="p-2 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white shadow-md">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                </div>
                <div>
                    <h1 class="font-bold text-base text-white tracking-wide">Abstract Studio</h1>
                    <p class="text-[11px] text-slate-400">4K / 8K Background Generator</p>
                </div>
            </div>
            
            <!-- Quick Preset Theme Selector -->
            <select id="selPresetTheme" class="bg-slate-800/80 text-xs text-indigo-300 border border-indigo-500/30 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <option value="" disabled selected>Preset Themes...</option>
                <option value="cyberpunk">Neon Cyberpunk</option>
                <option value="memphis">Memphis 80s</option>
                <option value="minimalist">Minimalist Lines</option>
                <option value="gold">Gold Luxury</option>
                <option value="fluid">Organic Fluid Flow</option>
                <option value="cosmic">Dark Cosmic</option>
                <option value="chalk">Chalk Scribbles</option>
            </select>
        </div>

        <!-- Accordion Controls Scroll Container -->
        <div class="flex-1 overflow-y-auto divide-y divide-white/5 p-3 space-y-2">

            <!-- 1. RESOLUTION & SEED -->
            <div class="accordion-item rounded-xl bg-white/5 overflow-hidden border border-white/5">
                <button class="accordion-header w-full p-3 text-left font-semibold text-xs text-slate-200 flex justify-between items-center hover:bg-white/5 transition">
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-2V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                        1. Canvas Resolution & Seed
                    </span>
                    <svg class="w-4 h-4 transform transition-transform text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="accordion-content p-3 space-y-3 text-xs bg-slate-900/40">
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-slate-400 mb-1">Preset Resolution</label>
                            <select id="selResolution" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
                                <option value="3840x2160" selected>4K UHD (3840x2160)</option>
                                <option value="7680x4320">8K UHD (7680x4320)</option>
                                <option value="1920x1080">Full HD (1920x1080)</option>
                                <option value="3440x1440">Ultrawide (3440x1440)</option>
                                <option value="1080x1920">Mobile (1080x1920)</option>
                                <option value="custom">Custom Resolution</option>
                            </select>
                        </div>
                        <div class="flex gap-1">
                            <div class="w-1/2">
                                <label class="block text-slate-400 mb-1">Width</label>
                                <input type="number" id="numWidth" value="3840" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none" disabled>
                            </div>
                            <div class="w-1/2">
                                <label class="block text-slate-400 mb-1">Height</label>
                                <input type="number" id="numHeight" value="2160" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none" disabled>
                            </div>
                        </div>
                    </div>

                    <div class="pt-2 border-t border-white/5 flex items-center gap-2">
                        <div class="flex-1">
                            <label class="block text-slate-400 mb-1">Random Seed</label>
                            <input type="text" id="txtSeed" value="123456" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 font-mono text-center focus:outline-none">
                        </div>
                        <button id="btnRandomSeed" class="mt-4 bg-slate-700 hover:bg-slate-600 text-slate-200 p-2 rounded-lg transition" title="Randomize Seed Only">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 2. BACKGROUND & ATMOSPHERE -->
            <div class="accordion-item rounded-xl bg-white/5 overflow-hidden border border-white/5">
                <button class="accordion-header w-full p-3 text-left font-semibold text-xs text-slate-200 flex justify-between items-center hover:bg-white/5 transition">
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                        2. Background & Atmosphere
                    </span>
                    <svg class="w-4 h-4 transform transition-transform text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="accordion-content p-3 space-y-3 text-xs bg-slate-900/40">
                    <div>
                        <label class="block text-slate-400 mb-1">Background Mode</label>
                        <select id="selBgType" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
                            <option value="linear">Linear Gradient</option>
                            <option value="radial">Radial Gradient</option>
                            <option value="conic">Conic Gradient</option>
                            <option value="mesh">Mesh / Multi-Point Gradient</option>
                            <option value="solid">Solid Color</option>
                        </select>
                    </div>

                    <!-- Colors -->
                    <div>
                        <label class="block text-slate-400 mb-1">Background Colors (Stops 1 to 4)</label>
                        <div class="grid grid-cols-4 gap-2">
                            <input type="color" id="colBg1" value="#0f172a" class="w-full h-8 rounded bg-slate-800 cursor-pointer border border-slate-700">
                            <input type="color" id="colBg2" value="#1e1b4b" class="w-full h-8 rounded bg-slate-800 cursor-pointer border border-slate-700">
                            <input type="color" id="colBg3" value="#311042" class="w-full h-8 rounded bg-slate-800 cursor-pointer border border-slate-700">
                            <input type="color" id="colBg4" value="#020617" class="w-full h-8 rounded bg-slate-800 cursor-pointer border border-slate-700">
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between text-slate-400 mb-1">
                            <span>Gradient Angle / Center Shift</span>
                            <span id="lblBgAngle">135°</span>
                        </div>
                        <input type="range" id="rngBgAngle" min="0" max="360" value="135" class="w-full">
                    </div>

                    <div class="pt-2 border-t border-white/5 grid grid-cols-2 gap-3">
                        <div>
                            <div class="flex justify-between text-slate-400 mb-1">
                                <span>Film Grain</span>
                                <span id="lblGrain">15%</span>
                            </div>
                            <input type="range" id="rngGrain" min="0" max="50" value="15" class="w-full">
                        </div>
                        <div>
                            <div class="flex justify-between text-slate-400 mb-1">
                                <span>Vignette</span>
                                <span id="lblVignette">40%</span>
                            </div>
                            <input type="range" id="rngVignette" min="0" max="100" value="40" class="w-full">
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. LINE SETTINGS -->
            <div class="accordion-item rounded-xl bg-white/5 overflow-hidden border border-white/5">
                <button class="accordion-header w-full p-3 text-left font-semibold text-xs text-slate-200 flex justify-between items-center hover:bg-white/5 transition">
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        3. Lines & Geometry (Straight, Waves, Grid)
                    </span>
                    <svg class="w-4 h-4 transform transition-transform text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="accordion-content p-3 space-y-3 text-xs bg-slate-900/40">
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-slate-400 mb-1">Line Pattern Type</label>
                            <select id="selLineType" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
                                <option value="none">None (Disabled)</option>
                                <option value="straight" selected>Straight Parallel / Angled</option>
                                <option value="sine">Sine Waves</option>
                                <option value="concentric">Concentric Circles</option>
                                <option value="grid">Grid / Mesh Network</option>
                                <option value="rays">Radial Rays</option>
                            </select>
                        </div>
                        <div>
                            <div class="flex justify-between text-slate-400 mb-1">
                                <span>Line Count</span>
                                <span id="lblLineCount">45</span>
                            </div>
                            <input type="range" id="rngLineCount" min="0" max="300" value="45" class="w-full">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <div class="flex justify-between text-slate-400 mb-1">
                                <span>Thickness (Min-Max)</span>
                            </div>
                            <div class="flex gap-1">
                                <input type="number" id="numLineThickMin" value="2" min="1" max="100" class="w-1/2 bg-slate-800 text-slate-200 border border-slate-700 rounded p-1">
                                <input type="number" id="numLineThickMax" value="12" min="1" max="100" class="w-1/2 bg-slate-800 text-slate-200 border border-slate-700 rounded p-1">
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-slate-400 mb-1">
                                <span>Opacity Range</span>
                            </div>
                            <div class="flex gap-1">
                                <input type="number" id="numLineOpacityMin" value="0.1" step="0.1" min="0" max="1" class="w-1/2 bg-slate-800 text-slate-200 border border-slate-700 rounded p-1">
                                <input type="number" id="numLineOpacityMax" value="0.7" step="0.1" min="0" max="1" class="w-1/2 bg-slate-800 text-slate-200 border border-slate-700 rounded p-1">
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-slate-400 mb-1">Dash Style</label>
                            <select id="selLineDash" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
                                <option value="solid">Solid</option>
                                <option value="dashed">Dashed</option>
                                <option value="dotted">Dotted</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-slate-400 mb-1">Line Blend Mode</label>
                            <select id="selLineBlend" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
                                <option value="source-over">Normal</option>
                                <option value="screen">Screen</option>
                                <option value="overlay">Overlay</option>
                                <option value="color-dodge">Color Dodge</option>
                                <option value="lighter" selected>Lighter / Additive</option>
                                <option value="difference">Difference</option>
                            </select>
                        </div>
                    </div>

                    <!-- Line Glow -->
                    <div class="pt-2 border-t border-white/5 grid grid-cols-2 gap-2">
                        <div>
                            <div class="flex justify-between text-slate-400 mb-1">
                                <span>Glow Radius</span>
                                <span id="lblLineGlow">15px</span>
                            </div>
                            <input type="range" id="rngLineGlow" min="0" max="80" value="15" class="w-full">
                        </div>
                        <div>
                            <label class="block text-slate-400 mb-1">Line Cap</label>
                            <select id="selLineCap" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
                                <option value="round">Round</option>
                                <option value="butt">Butt / Square</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. SQUIGGLES & CURVES -->
            <div class="accordion-item rounded-xl bg-white/5 overflow-hidden border border-white/5">
                <button class="accordion-header w-full p-3 text-left font-semibold text-xs text-slate-200 flex justify-between items-center hover:bg-white/5 transition">
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 0L4 4m5.121 5.121L4 14.121"/></svg>
                        4. Squiggles, Ribbons & Fluid Curves
                    </span>
                    <svg class="w-4 h-4 transform transition-transform text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="accordion-content p-3 space-y-3 text-xs bg-slate-900/40">
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-slate-400 mb-1">Squiggle Style</label>
                            <select id="selSquiggleStyle" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
                                <option value="bezier" selected>Smooth Bezier Curves</option>
                                <option value="scribble">Sharp Scribble</option>
                                <option value="ribbon">Tapered Ribbon</option>
                                <option value="tube">3D Tube Effect</option>
                                <option value="flow">Noise Flow Field Lines</option>
                            </select>
                        </div>
                        <div>
                            <div class="flex justify-between text-slate-400 mb-1">
                                <span>Squiggle Count</span>
                                <span id="lblSquiggleCount">35</span>
                            </div>
                            <input type="range" id="rngSquiggleCount" min="0" max="200" value="35" class="w-full">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <div class="flex justify-between text-slate-400 mb-1">
                                <span>Complexity / Points</span>
                                <span id="lblSquigglePoints">6</span>
                            </div>
                            <input type="range" id="rngSquigglePoints" min="3" max="20" value="6" class="w-full">
                        </div>
                        <div>
                            <div class="flex justify-between text-slate-400 mb-1">
                                <span>Thickness (Min-Max)</span>
                            </div>
                            <div class="flex gap-1">
                                <input type="number" id="numSquiggleThickMin" value="10" min="1" max="200" class="w-1/2 bg-slate-800 text-slate-200 border border-slate-700 rounded p-1">
                                <input type="number" id="numSquiggleThickMax" value="60" min="1" max="200" class="w-1/2 bg-slate-800 text-slate-200 border border-slate-700 rounded p-1">
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-slate-400 mb-1">Tapering</label>
                            <select id="selSquiggleTaper" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
                                <option value="none">Uniform Thickness</option>
                                <option value="both" selected>Taper Both Ends</option>
                                <option value="start">Taper Start Only</option>
                                <option value="end">Taper End Only</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-slate-400 mb-1">Fill Mode</label>
                            <select id="selSquiggleFill" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
