                lineType: 'rays', lineCount: 50, lineBlend: 'screen', lineGlow: 10,
                squiggleStyle: 'ribbon', squiggleCount: 20,
                palette: ['#d4af37', '#f3e5ab', '#aa7c11', '#fff8dc', '#8b6508'],
                accentType: 'rings', accentCount: 40
            },
            fluid: {
                bgType: 'mesh', colBg1: '#0f172a', colBg2: '#0284c7', colBg3: '#4f46e5', colBg4: '#030712',
                lineType: 'none',
                squiggleStyle: 'flow', squiggleCount: 120, squiggleThickMin: 5, squiggleThickMax: 35,
                palette: ['#38bdf8', '#818cf8', '#c084fc', '#34d399', '#ffffff'],
                symmetry: 'horizontal', accentType: 'none'
            },
            cosmic: {
                bgType: 'radial', colBg1: '#1e1b4b', colBg2: '#090514',
                lineType: 'rays', lineCount: 80, lineGlow: 25,
                squiggleStyle: 'bezier', squiggleCount: 30,
                symmetry: 'radial6',
                palette: ['#ec4899', '#8b5cf6', '#06b6d4', '#f43f5e', '#ffffff'],
                accentType: 'stars', accentCount: 120
            },
            chalk: {
                bgType: 'solid', colBg1: '#1e293b',
                lineType: 'grid', lineCount: 20, lineDash: 'dashed', lineGlow: 0,
                squiggleStyle: 'scribble', squiggleCount: 50, squiggleThickMin: 2, squiggleThickMax: 6,
                palette: ['#ffffff', '#fef08a', '#fbcfe8', '#bae6fd', '#f5f5f5'],
                accentType: 'micro', accentCount: 90
            }
        };

        // ==========================================
        // COLOR HELPERS
        // ==========================================
        function hexToRgb(hex) {
            let c = hex.replace('#', '');
            if (c.length === 3) c = c.split('').map(x => x + x).join('');
            const num = parseInt(c, 16);
            return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
        }

        function adjustColor(hex, satOffset, brightOffset, alpha = 1) {
            let { r, g, b } = hexToRgb(hex);
            r /= 255; g /= 255; b /= 255;
            const max = Math.max(r, g, b), min = Math.min(r, g, b);
            let h, s, l = (max + min) / 2;

            if (max === min) {
                h = s = 0;
            } else {
                const d = max - min;
                s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
                switch (max) {
                    case r: h = (g - b) / d + (g < b ? 6 : 0); break;
                    case g: h = (b - r) / d + 2; break;
                    case b: h = (r - g) / d + 4; break;
                }
                h /= 6;
            }

            s = Math.max(0, Math.min(1, s + satOffset / 100));
            l = Math.max(0, Math.min(1, l + brightOffset / 100));

            return `hsla(${Math.round(h * 360)}, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%, ${alpha})`;
        }

        function getRandomPaletteColor(alpha = 1) {
            const hex = prng.choice(state.palette);
            return adjustColor(hex, state.satShift, state.brightShift, alpha);
        }

        // ==========================================
        // DRAWING FUNCTIONS
        // ==========================================
        function drawBackground(targetCtx, w, h) {
            const bg1 = adjustColor(state.colBg1, state.satShift, state.brightShift);
            const bg2 = adjustColor(state.colBg2, state.satShift, state.brightShift);
            const bg3 = adjustColor(state.colBg3, state.satShift, state.brightShift);
            const bg4 = adjustColor(state.colBg4, state.satShift, state.brightShift);

            if (state.bgType === 'solid') {
                targetCtx.fillStyle = bg1;
                targetCtx.fillRect(0, 0, w, h);
            } else if (state.bgType === 'linear') {
                const rad = (state.bgAngle * Math.PI) / 180;
                const cx = w / 2, cy = h / 2;
                const diag = Math.sqrt(w * w + h * h) / 2;
                const x0 = cx - Math.cos(rad) * diag;
                const y0 = cy - Math.sin(rad) * diag;
                const x1 = cx + Math.cos(rad) * diag;
                const y1 = cy + Math.sin(rad) * diag;

                const grad = targetCtx.createLinearGradient(x0, y0, x1, y1);
                grad.addColorStop(0, bg1);
                grad.addColorStop(0.33, bg2);
                grad.addColorStop(0.66, bg3);
                grad.addColorStop(1, bg4);
                targetCtx.fillStyle = grad;
                targetCtx.fillRect(0, 0, w, h);
            } else if (state.bgType === 'radial') {
                const grad = targetCtx.createRadialGradient(w / 2, h / 2, 50, w / 2, h / 2, Math.max(w, h) * 0.7);
                grad.addColorStop(0, bg1);
                grad.addColorStop(0.4, bg2);
                grad.addColorStop(0.8, bg3);
                grad.addColorStop(1, bg4);
                targetCtx.fillStyle = grad;
                targetCtx.fillRect(0, 0, w, h);
            } else if (state.bgType === 'conic') {
                const grad = targetCtx.createConicGradient((state.bgAngle * Math.PI) / 180, w / 2, h / 2);
                grad.addColorStop(0, bg1);
                grad.addColorStop(0.25, bg2);
                grad.addColorStop(0.5, bg3);
                grad.addColorStop(0.75, bg4);
                grad.addColorStop(1, bg1);
                targetCtx.fillStyle = grad;
                targetCtx.fillRect(0, 0, w, h);
            } else if (state.bgType === 'mesh') {
                targetCtx.fillStyle = bg4;
                targetCtx.fillRect(0, 0, w, h);

                const points = [
                    { x: w * 0.2, y: h * 0.2, color: bg1, r: w * 0.5 },
                    { x: w * 0.8, y: h * 0.3, color: bg2, r: w * 0.6 },
                    { x: w * 0.3, y: h * 0.8, color: bg3, r: w * 0.55 },
                    { x: w * 0.7, y: h * 0.75, color: bg1, r: w * 0.45 }
                ];

                targetCtx.globalCompositeOperation = 'screen';
                points.forEach(p => {
                    const g = targetCtx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r);
                    g.addColorStop(0, p.color);
                    g.addColorStop(1, 'transparent');
                    targetCtx.fillStyle = g;
                    targetCtx.beginPath();
                    targetCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    targetCtx.fill();
                });
                targetCtx.globalCompositeOperation = 'source-over';
            }
        }

        function drawLines(targetCtx, w, h) {
            if (state.lineType === 'none' || state.lineCount <= 0) return;

            targetCtx.save();
            targetCtx.globalCompositeOperation = state.lineBlend;
            if (state.lineGlow > 0) {
                targetCtx.shadowBlur = state.lineGlow;
                targetCtx.shadowColor = getRandomPaletteColor(0.8);
            }

            for (let i = 0; i < state.lineCount; i++) {
                targetCtx.beginPath();
                const opacity = prng.range(state.lineOpacityMin, state.lineOpacityMax);
                const thick = prng.range(state.lineThickMin, state.lineThickMax);

                targetCtx.strokeStyle = getRandomPaletteColor(opacity);
                targetCtx.lineWidth = thick;
                targetCtx.lineCap = state.lineCap;

                if (state.lineDash === 'dashed') targetCtx.setLineDash([thick * 3, thick * 2]);
                else if (state.lineDash === 'dotted') targetCtx.setLineDash([thick, thick]);
                else targetCtx.setLineDash([]);

                if (state.lineType === 'straight') {
                    const x1 = prng.range(-w * 0.2, w * 1.2);
                    const y1 = prng.range(-h * 0.2, h * 1.2);
                    const angle = (state.bgAngle + prng.range(-30, 30)) * Math.PI / 180;
                    const len = Math.max(w, h) * 1.5;
                    targetCtx.moveTo(x1, y1);
                    targetCtx.lineTo(x1 + Math.cos(angle) * len, y1 + Math.sin(angle) * len);
                } else if (state.lineType === 'sine') {
                    const startY = prng.range(0, h);
                    const freq = prng.range(0.001, 0.005);
                    const amp = prng.range(50, 300);
                    targetCtx.moveTo(0, startY);
                    for (let x = 0; x < w; x += 30) {
                        targetCtx.lineTo(x, startY + Math.sin(x * freq) * amp);
                    }
                } else if (state.lineType === 'concentric') {
                    const cx = w / 2, cy = h / 2;
                    const r = (i + 1) * (Math.max(w, h) * 0.6 / state.lineCount);
                    targetCtx.arc(cx, cy, r, 0, Math.PI * 2);
                } else if (state.lineType === 'grid') {
                    const step = w / Math.sqrt(state.lineCount);
                    if (i % 2 === 0) {
                        const x = (i / 2) * step;
                        targetCtx.moveTo(x, 0); targetCtx.lineTo(x, h);
                    } else {
                        const y = Math.floor(i / 2) * step;
                        targetCtx.moveTo(0, y); targetCtx.lineTo(w, y);
                    }
                } else if (state.lineType === 'rays') {
                    const cx = w / 2, cy = h / 2;
                    const angle = (i / state.lineCount) * Math.PI * 2;
                    targetCtx.moveTo(cx, cy);
                    targetCtx.lineTo(cx + Math.cos(angle) * w, cy + Math.sin(angle) * w);
                }

                targetCtx.stroke();
            }
            targetCtx.restore();
        }

        function drawSquiggles(targetCtx, w, h) {
            if (state.squiggleCount <= 0) return;

            for (let i = 0; i < state.squiggleCount; i++) {
                targetCtx.save();
                const color = getRandomPaletteColor(prng.range(0.4, 0.95));
                const thickMin = state.squiggleThickMin;
                const thickMax = state.squiggleThickMax;
                const ptsCount = state.squigglePoints;

                // Generate Path Control Points
                const points = [];
                let currX = prng.range(w * 0.1, w * 0.9);
                let currY = prng.range(h * 0.1, h * 0.9);
                points.push({ x: currX, y: currY });

                for (let p = 0; p < ptsCount; p++) {
                    currX += prng.range(-w * 0.25, w * 0.25);
                    currY += prng.range(-h * 0.25, h * 0.25);
                    points.push({ x: currX, y: currY });
                }

                if (state.squiggleStyle === 'flow') {
                    // Draw noise field particle path
                    targetCtx.beginPath();
                    let fx = prng.range(0, w);
                    let fy = prng.range(0, h);
                    targetCtx.moveTo(fx, fy);
                    targetCtx.strokeStyle = color;
                    targetCtx.lineWidth = prng.range(thickMin, thickMax);
                    targetCtx.lineCap = 'round';

                    for (let step = 0; step < 80; step++) {
                        const angle = simplex.noise2D(fx * state.noiseScale, fy * state.noiseScale) * Math.PI * 4;
                        fx += Math.cos(angle) * state.noiseForce;
                        fy += Math.sin(angle) * state.noiseForce;
                        targetCtx.lineTo(fx, fy);
                    }
                    targetCtx.stroke();
                } else if (state.squiggleStyle === 'scribble') {
                    targetCtx.beginPath();
                    targetCtx.moveTo(points[0].x, points[0].y);
                    for (let p = 1; p < points.length; p++) {
                        targetCtx.lineTo(points[p].x, points[p].y);
                    }
                    targetCtx.strokeStyle = color;
                    targetCtx.lineWidth = prng.range(thickMin, thickMax);
                    targetCtx.lineJoin = 'miter';
                    targetCtx.stroke();
                } else if (state.squiggleStyle === 'tube') {
                    // 3D Tube Effect (Multiple rendered layered strokes)
                    const baseThick = prng.range(thickMin, thickMax);
                    targetCtx.beginPath();
                    targetCtx.moveTo(points[0].x, points[0].y);
                    for (let p = 1; p < points.length - 1; p++) {
                        const xc = (points[p].x + points[p + 1].x) / 2;
                        const yc = (points[p].y + points[p + 1].y) / 2;
                        targetCtx.quadraticCurveTo(points[p].x, points[p].y, xc, yc);
                    }
                    
                    // Outer shadow stroke
                    targetCtx.strokeStyle = 'rgba(0,0,0,0.5)';
                    targetCtx.lineWidth = baseThick;
                    targetCtx.lineCap = 'round';
                    targetCtx.stroke();

                    // Main color stroke
                    targetCtx.strokeStyle = color;
                    targetCtx.lineWidth = baseThick * 0.8;
                    targetCtx.stroke();

                    // Inner highlight line
                    targetCtx.strokeStyle = 'rgba(255,255,255,0.7)';
                    targetCtx.lineWidth = baseThick * 0.25;
                    targetCtx.stroke();
                } else {
                    // Smooth Bezier Curve or Tapered Ribbon
                    targetCtx.beginPath();
                    targetCtx.moveTo(points[0].x, points[0].y);
                    for (let p = 1; p < points.length - 1; p++) {
                        const xc = (points[p].x + points[p + 1].x) / 2;
                        const yc = (points[p].y + points[p + 1].y) / 2;
                        targetCtx.quadraticCurveTo(points[p].x, points[p].y, xc, yc);
                    }

                    if (state.squiggleFill === 'filled') {
                        targetCtx.fillStyle = color;
                        targetCtx.closePath();
                        targetCtx.fill();
                    } else {
                        targetCtx.strokeStyle = color;
                        targetCtx.lineWidth = prng.range(thickMin, thickMax);
                        targetCtx.lineCap = 'round';
                        targetCtx.stroke();
                    }
                }
                targetCtx.restore();
            }
        }

        function drawAccents(targetCtx, w, h) {
            if (state.accentType === 'none' || state.accentCount <= 0) return;

            for (let i = 0; i < state.accentCount; i++) {
                targetCtx.save();
                const x = prng.range(0, w);
                const y = prng.range(0, h);
                const size = prng.range(state.accentSizeMin, state.accentSizeMax);
                const color = getRandomPaletteColor(prng.range(0.2, state.accentOpacity));
                const type = state.accentType === 'mixed' ? prng.choice(['dots', 'crosses', 'rings', 'triangles', 'stars', 'micro']) : state.accentType;

                targetCtx.translate(x, y);
                targetCtx.rotate(prng.range(0, Math.PI * 2));
                targetCtx.fillStyle = color;
                targetCtx.strokeStyle = color;
                targetCtx.lineWidth = Math.max(2, size * 0.15);

                if (type === 'dots') {
                    targetCtx.beginPath();
                    targetCtx.arc(0, 0, size / 2, 0, Math.PI * 2);
                    targetCtx.fill();
                } else if (type === 'crosses') {
                    targetCtx.beginPath();
                    targetCtx.moveTo(-size / 2, 0); targetCtx.lineTo(size / 2, 0);
                    targetCtx.moveTo(0, -size / 2); targetCtx.lineTo(0, size / 2);
                    targetCtx.stroke();
                } else if (type === 'rings') {
                    targetCtx.beginPath();
                    targetCtx.arc(0, 0, size / 2, 0, Math.PI * 2);
                    targetCtx.stroke();
                } else if (type === 'triangles') {
                    targetCtx.beginPath();
                    targetCtx.moveTo(0, -size / 2);
                    targetCtx.lineTo(size / 2, size / 2);
                    targetCtx.lineTo(-size / 2, size / 2);
                    targetCtx.closePath();
                    targetCtx.fill();
                } else if (type === 'stars') {
                    targetCtx.beginPath();
                    for (let s = 0; s < 4; s++) {
                        targetCtx.rotate(Math.PI / 4);
                        targetCtx.moveTo(-size / 2, 0); targetCtx.lineTo(size / 2, 0);
                    }
                    targetCtx.stroke();
                } else if (type === 'micro') {
                    targetCtx.beginPath();
                    targetCtx.moveTo(-size, 0);
                    targetCtx.quadraticCurveTo(0, -size, size, 0);
                    targetCtx.stroke();
                }

                targetCtx.restore();
            }
        }

        function applyFilmGrainAndVignette(targetCtx, w, h) {
            // Film Grain
            if (state.grain > 0) {
                const grainCanvas = document.createElement('canvas');
                grainCanvas.width = 256;
                grainCanvas.height = 256;
                const gCtx = grainCanvas.getContext('2d');
                const imgData = gCtx.createImageData(256, 256);
                const data = imgData.data;

                for (let i = 0; i < data.length; i += 4) {
                    const val = Math.floor(Math.random() * 255);
                    data[i] = val; data[i+1] = val; data[i+2] = val;
                    data[i+3] = Math.floor((state.grain / 100) * 255 * 0.3);
                }
                gCtx.putImageData(imgData, 0, 0);

                targetCtx.save();
                targetCtx.fillStyle = targetCtx.createPattern(grainCanvas, 'repeat');
                targetCtx.globalCompositeOperation = 'overlay';
                targetCtx.fillRect(0, 0, w, h);
                targetCtx.restore();
            }

            // Vignette
            if (state.vignette > 0) {
                targetCtx.save();
                const radGrad = targetCtx.createRadialGradient(w / 2, h / 2, Math.max(w, h) * 0.3, w / 2, h / 2, Math.max(w, h) * 0.7);
                radGrad.addColorStop(0, 'rgba(0,0,0,0)');
                radGrad.addColorStop(1, `rgba(0,0,0,${state.vignette / 100})`);
                targetCtx.fillStyle = radGrad;
                targetCtx.fillRect(0, 0, w, h);
                targetCtx.restore();
            }
        }

        // ==========================================
        // RENDER PIPELINE
        // ==========================================
        function render() {
            const startTime = performance.now();
            
            // Sync canvas sizes
            const w = state.width;
            const h = state.height;
            if (canvas.width !== w || canvas.height !== h) {
                canvas.width = w; canvas.height = h;
                offCanvas.width = w; offCanvas.height = h;
            }

            // Initialize PRNG with Seed
            let seedNum = 0;
            for (let i = 0; i < state.seed.length; i++) seedNum += state.seed.charCodeAt(i) * (i + 1);
            prng = new Mulberry32(seedNum || 123456);
            simplex = new FastSimplexNoise(prng);

            // Draw Base Art on Offscreen Layer
            offCtx.clearRect(0, 0, w, h);
            drawBackground(offCtx, w, h);
            drawLines(offCtx, w, h);
            drawSquiggles(offCtx, w, h);
            drawAccents(offCtx, w, h);

            // Apply Symmetry to Main Canvas
            ctx.clearRect(0, 0, w, h);
            ctx.save();

            if (state.symmetry === 'none') {
                ctx.drawImage(offCanvas, 0, 0);
            } else if (state.symmetry === 'horizontal') {
                ctx.drawImage(offCanvas, 0, 0);
                ctx.scale(-1, 1);
                ctx.drawImage(offCanvas, -w, 0);
            } else if (state.symmetry === 'vertical') {
                ctx.drawImage(offCanvas, 0, 0);
                ctx.scale(1, -1);
                ctx.drawImage(offCanvas, 0, -h);
            } else if (state.symmetry === 'quad') {
                ctx.drawImage(offCanvas, 0, 0);
                ctx.scale(-1, 1); ctx.drawImage(offCanvas, -w, 0);
                ctx.scale(1, -1); ctx.drawImage(offCanvas, -w, -h);
                ctx.scale(-1, 1); ctx.drawImage(offCanvas, 0, -h);
            } else if (state.symmetry.startsWith('radial')) {
                const count = parseInt(state.symmetry.replace('radial', '')) || 6;
                ctx.translate(w / 2, h / 2);
                for (let i = 0; i < count; i++) {
                    ctx.rotate((Math.PI * 2) / count);
                    ctx.drawImage(offCanvas, -w / 2, -h / 2);
                }
            }

            ctx.restore();

            // Post-processing Grain & Vignette directly on final canvas
            applyFilmGrainAndVignette(ctx, w, h);

            const duration = Math.round(performance.now() - startTime);
            document.getElementById('statusText').innerText = `${w}x${h} • ${duration}ms`;
        }

        // Debounced Render for Silky Smooth Slider Dragging
        let renderTimer = null;
        function queueRender() {
            if (renderTimer) clearTimeout(renderTimer);
            renderTimer = setTimeout(render, 20);
        }

        // ==========================================
        // UI BINDINGS & EVENT HANDLERS
        // ==========================================
        function bindInputs() {
            // Accordion toggle
            document.querySelectorAll('.accordion-header').forEach(btn => {
                btn.addEventListener('click', () => {
                    const content = btn.nextElementSibling;
                    const icon = btn.querySelector('svg:last-child');
                    content.classList.toggle('active');
                    icon.classList.toggle('rotate-180');
                });
            });

            // Open first accordion by default
            document.querySelector('.accordion-content').classList.add('active');

            // Resolution Presets
            const selRes = document.getElementById('selResolution');
            const numW = document.getElementById('numWidth');
            const numH = document.getElementById('numHeight');

            selRes.addEventListener('change', (e) => {
                if (e.target.value === 'custom') {
                    numW.disabled = false; numH.disabled = false;
                } else {
                    numW.disabled = true; numH.disabled = true;
                    const [w, h] = e.target.value.split('x').map(Number);
                    state.width = w; state.height = h;
                    numW.value = w; numH.value = h;
                    document.getElementById('btnExportResLabel').innerText = e.target.value.includes('7680') ? '8K' : '4K';
                    queueRender();
                }
            });

            numW.addEventListener('input', () => { state.width = parseInt(numW.value) || 1920; queueRender(); });
            numH.addEventListener('input', () => { state.height = parseInt(numH.value) || 1080; queueRender(); });

            // Random Seed
            const txtSeed = document.getElementById('txtSeed');
            txtSeed.addEventListener('input', (e) => { state.seed = e.target.value; queueRender(); });
            document.getElementById('btnRandomSeed').addEventListener('click', () => {
                state.seed = Math.floor(Math.random() * 999999).toString();
                txtSeed.value = state.seed;
                queueRender();
            });

            // Generic Element Input Bindings
            const bindings = [
                { id: 'selBgType', key: 'bgType' },
                { id: 'colBg1', key: 'colBg1' },
                { id: 'colBg2', key: 'colBg2' },
                { id: 'colBg3', key: 'colBg3' },
                { id: 'colBg4', key: 'colBg4' },
                { id: 'rngBgAngle', key: 'bgAngle', lbl: 'lblBgAngle', unit: '°' },
                { id: 'rngGrain', key: 'grain', lbl: 'lblGrain', unit: '%' },
                { id: 'rngVignette', key: 'vignette', lbl: 'lblVignette', unit: '%' },

                { id: 'selLineType', key: 'lineType' },
                { id: 'rngLineCount', key: 'lineCount', lbl: 'lblLineCount' },
                { id: 'numLineThickMin', key: 'lineThickMin' },
                { id: 'numLineThickMax', key: 'lineThickMax' },
                { id: 'numLineOpacityMin', key: 'lineOpacityMin' },
                { id: 'numLineOpacityMax', key: 'lineOpacityMax' },
                { id: 'selLineDash', key: 'lineDash' },
                { id: 'selLineBlend', key: 'lineBlend' },
                { id: 'rngLineGlow', key: 'lineGlow', lbl: 'lblLineGlow', unit: 'px' },
                { id: 'selLineCap', key: 'lineCap' },

                { id: 'selSquiggleStyle', key: 'squiggleStyle' },
                { id: 'rngSquiggleCount', key: 'squiggleCount', lbl: 'lblSquiggleCount' },
                { id: 'rngSquigglePoints', key: 'squigglePoints', lbl: 'lblSquigglePoints' },
                { id: 'numSquiggleThickMin', key: 'squiggleThickMin' },
                { id: 'numSquiggleThickMax', key: 'squiggleThickMax' },
                { id: 'selSquiggleTaper', key: 'squiggleTaper' },
                { id: 'selSquiggleFill', key: 'squiggleFill' },

                { id: 'selSymmetry', key: 'symmetry' },
                { id: 'rngNoiseScale', key: 'noiseScale', lbl: 'lblNoiseScale' },
                { id: 'rngNoiseForce', key: 'noiseForce', lbl: 'lblNoiseForce' },

                { id: 'colPal1', key: 'pal1' },
                { id: 'colPal2', key: 'pal2' },
                { id: 'colPal3', key: 'pal3' },
                { id: 'colPal4', key: 'pal4' },
                { id: 'colPal5', key: 'pal5' },
                { id: 'rngSat', key: 'satShift', lbl: 'lblSat', unit: '%' },
                { id: 'rngBright', key: 'brightShift', lbl: 'lblBright', unit: '%' },

                { id: 'selAccentType', key: 'accentType' },
                { id: 'rngAccentCount', key: 'accentCount', lbl: 'lblAccentCount' },
                { id: 'numAccentSizeMin', key: 'accentSizeMin' },
                { id: 'numAccentSizeMax', key: 'accentSizeMax' },
                { id: 'rngAccentOpacity', key: 'accentOpacity', lbl: 'lblAccentOpacity' }
            ];

            bindings.forEach(b => {
                const el = document.getElementById(b.id);
                if (!el) return;
                el.addEventListener('input', (e) => {
                    let val = e.target.value;
                    if (e.target.type === 'number' || e.target.type === 'range') val = parseFloat(val);
                    
                    if (b.key.startsWith('pal')) {
                        const idx = parseInt(b.key.replace('pal', '')) - 1;
                        state.palette[idx] = val;
                    } else {
                        state[b.key] = val;
                    }

                    if (b.lbl) {
                        const lblEl = document.getElementById(b.lbl);
                        if (lblEl) lblEl.innerText = val + (b.unit || '');
                    }
                    queueRender();
                });
            });

            // Preset Palettes
            document.getElementById('selPalettePreset').addEventListener('change', (e) => {
                const preset = PALETTE_PRESETS[e.target.value];
                if (preset) {
                    state.palette = [...preset];
                    for (let i = 0; i < 5; i++) {
                        document.getElementById(`colPal${i + 1}`).value = preset[i];
                    }
                    queueRender();
                }
            });

            // Preset Themes
            document.getElementById('selPresetTheme').addEventListener('change', (e) => {
                const theme = THEME_PRESETS[e.target.value];
                if (theme) {
                    Object.assign(state, theme);
                    syncUIFromState();
                    queueRender();
                }
            });

            // Randomize All Button
            document.getElementById('btnRandomizeAll').addEventListener('click', () => {
                state.seed = Math.floor(Math.random() * 999999).toString();
                txtSeed.value = state.seed;
                
                // Pick random theme palette
                const themeKeys = Object.keys(THEME_PRESETS);
                const randomTheme = THEME_PRESETS[prng.choice(themeKeys)];
                Object.assign(state, randomTheme);

                syncUIFromState();
                queueRender();
            });

            // Toggle UI Panel (Hotkey H)
            const sidebar = document.getElementById('sidebar');
            const btnToggleUI = document.getElementById('btnToggleUI');
            const lblToggleUI = document.getElementById('lblToggleUI');

            function toggleUI() {
                sidebar.classList.toggle('-ml-[420px]');
                sidebar.classList.toggle('sm:-ml-[420px]');
                lblToggleUI.innerText = sidebar.classList.contains('-ml-[420px]') ? 'Show Panel' : 'Hide Panel';
            }

            btnToggleUI.addEventListener('click', toggleUI);
            window.addEventListener('keydown', (e) => {
                if (e.key.toLowerCase() === 'h' && e.target.tagName !== 'INPUT') {
                    toggleUI();
                }
            });

            // High Resolution PNG Export
            document.getElementById('btnExport').addEventListener('click', () => {
                const btn = document.getElementById('btnExport');
                btn.classList.add('opacity-50', 'pointer-events-none');
                
                setTimeout(() => {
                    try {
                        const dataUrl = canvas.toDataURL('image/png');
                        const link = document.createElement('a');
                        link.download = `Abstract_Background_${state.width}x${state.height}_${Date.now()}.png`;
                        link.href = dataUrl;
                        link.click();
                        link.remove();
                    } catch (err) {
                        alert('Export failed: Canvas memory limit exceeded.');
                    } finally {
                        btn.classList.remove('opacity-50', 'pointer-events-none');
                    }
                }, 50);
            });
        }

        function syncUIFromState() {
            document.getElementById('selBgType').value = state.bgType;
            document.getElementById('colBg1').value = state.colBg1;
            document.getElementById('colBg2').value = state.colBg2;
            document.getElementById('colBg3').value = state.colBg3;
            document.getElementById('colBg4').value = state.colBg4;
            document.getElementById('selLineType').value = state.lineType;
            document.getElementById('rngLineCount').value = state.lineCount;
            document.getElementById('lblLineCount').innerText = state.lineCount;
            document.getElementById('selSquiggleStyle').value = state.squiggleStyle;
            document.getElementById('rngSquiggleCount').value = state.squiggleCount;
            document.getElementById('lblSquiggleCount').innerText = state.squiggleCount;
            document.getElementById('selSymmetry').value = state.symmetry;
            document.getElementById('selAccentType').value = state.accentType;
            document.getElementById('rngAccentCount').value = state.accentCount;
            document.getElementById('lblAccentCount').innerText = state.accentCount;

            for (let i = 0; i < 5; i++) {
                if (state.palette[i]) {
                    document.getElementById(`colPal${i + 1}`).value = state.palette[i];
                }
            }
        }

        // Initialize App on Window Load
        window.addEventListener('load', () => {
            bindInputs();
            render();
        });
    </script>
</body>
