            pastel: ['#f472b6', '#38bdf8', '#c084fc', '#fde047', '#f8fafc'],
            sunset: ['#ff4800', '#ff7b00', '#ffb700', '#e01e5a', '#ffffff'],
            gold: ['#d4af37', '#f3e5ab', '#aa7c11', '#5c4033', '#ffffff'],
            earthy: ['#2d6a4f', '#52b788', '#b7e4c7', '#d8f3dc', '#1b4332'],
            monochrome: ['#f8fafc', '#94a3b8', '#475569', '#1e293b', '#cbd5e1']
        };

        // Preset Complete Themes
        const THEME_PRESETS = {
            cyberpunk: {
